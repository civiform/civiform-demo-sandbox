# cf-sandbox-builder — Environment Variables Reference
#
# In AWS ECS Fargate (production), all environment variables and Secrets Manager
# secrets are wired automatically by `terraform/ecs.tf` on `aws_ecs_task_definition.builder`.
#
# For local Docker development, `docker-compose.yml` already provides working defaults.
# Use this file only if you are overriding variables locally (e.g. testing Auth0 OIDC
# or running the builder locally against AWS via `SANDBOX_RUNTIME=terraform`).
#
# DO NOT commit `.env` to git — it contains secrets.

# ── Play / Portal ──────────────────────────────────────────────────────────────
APPLICATION_SECRET=<32+ char random secret — generate with: openssl rand -base64 32>
APP_BASE_URL=https://sandbox.civiform.dev

# ── Portal Authentication (Auth0 OIDC or Local Password Fallback) ──────────────
# When AUTH0_DOMAIN, AUTH0_CLIENT_ID, and AUTH0_CLIENT_SECRET are set, Auth0 OIDC
# login is active and password login is disabled.
AUTH0_DOMAIN=civiform-sandbox-builder.us.auth0.com
AUTH0_CLIENT_ID=<auth0-client-id>
AUTH0_CLIENT_SECRET=<auth0-client-secret>
# Optional override; defaults to ${APP_BASE_URL}/callback
AUTH0_CALLBACK_URL=https://sandbox.civiform.dev/callback

# Local fallback password for admin@civiform.dev (used only when Auth0 is unset)
DEMO_PORTAL_PASSWORD=demo

# ── Builder Metadata Database ──────────────────────────────────────────────────
DB_JDBC_URL=jdbc:postgresql://<RDS_HOST>:5432/civiform_sandbox?ssl=true&sslmode=require
DB_USER=sandbox_master
DB_PASSWORD=<rds-master-password>

# ── Runtime Selector ───────────────────────────────────────────────────────────
# "docker"    → DockerSandboxService     (local Docker socket)
# "terraform" → TerraformSandboxService  (AWS ECS Fargate + RDS via terraform/sandbox)
SANDBOX_RUNTIME=terraform

# ── Terraform Runtime (read when SANDBOX_RUNTIME=terraform) ────────────────────
AWS_REGION=us-east-1
TERRAFORM_STATE_BUCKET=civiform-sandbox-tfstate
TERRAFORM_MODULE_DIR=/app/terraform/sandbox
CIVIFORM_IMAGE_TAG=latest

# In AWS ECS, `terraform/ecs.tf` injects `PLATFORM_OUTPUTS_JSON` directly.
# When running locally against AWS, generate `terraform/platform-outputs.json`:
#   terraform -chdir=terraform output -json > terraform/platform-outputs.json
PLATFORM_OUTPUTS_FILE=/app/platform-outputs.json
# PLATFORM_OUTPUTS_JSON=

# ── Shared RDS Admin Connection (used to CREATE/DROP per-sandbox databases) ────
RDS_ADMIN_DATABASE=postgres
RDS_ADMIN_USER=sandbox_master
RDS_ADMIN_PASSWORD=<rds-master-password>

# Leave empty in AWS (defaults to `rds_endpoint` from platform outputs).
# When running locally on a laptop with `./bin/rds-tunnel`, set:
#   RDS_ADMIN_HOST=host.docker.internal
#   RDS_ADMIN_PORT=15432
RDS_ADMIN_HOST=
RDS_ADMIN_PORT=5432
