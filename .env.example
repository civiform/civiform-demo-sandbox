# cf-sandbox-builder — Environment Variables Reference
# Copy to .env and fill in values for production (Fargate) deployment.
# For local Docker development, docker-compose.yml already has safe defaults.
#
# DO NOT commit .env to git — it contains secrets.

# ── Play / App ─────────────────────────────────────────────────────────────────
APPLICATION_SECRET=<32+ char random secret — generate with: openssl rand -base64 32>
APP_BASE_URL=https://sandbox-builder.civiform.dev

# ── Database (builder's own Postgres — NOT the sandbox RDS) ───────────────────
DB_JDBC_URL=jdbc:postgresql://<RDS_HOST>:5432/sandbox_builder
DB_USER=sandbox_builder
DB_PASSWORD=<secure password>

# ── Runtime selector ───────────────────────────────────────────────────────────
# "docker"  → DockerSandboxService  (Sprint 1 local dev only)
# "fargate" → EcsFargateSandboxService (Sprint 2+ AWS production)
SANDBOX_RUNTIME=fargate

# ── Sprint 2: ECS Fargate + Wildcard Subdomain ─────────────────────────────────

# Wildcard domain — sandboxes get {slug}.sandbox.civiform.dev
# e.g. Burlington, VT → burlington-vt.sandbox.civiform.dev
SANDBOX_DOMAIN=sandbox.civiform.dev

# VPC where ECS sandbox tasks run (get from Rocky / Terraform output)
SANDBOX_VPC_ID=vpc-xxxxxxxxxxxxxxxxx

# AWS region
AWS_REGION=us-east-1

# ECS cluster (matches terraform/ecs.tf: aws_ecs_cluster.sandbox.name)
ECS_CLUSTER=civiform-sandbox-cluster

# Private subnets for ECS tasks — comma-separated, set as HOCON list in app
# Format in application.conf: ["subnet-xxx", "subnet-yyy"]
ECS_SUBNETS=subnet-xxxxxxxxxxxxxxxxx,subnet-yyyyyyyyyyyyyyyyy

# Security group for ECS tasks (allows 9000 inbound from ALB SG)
ECS_SECURITY_GROUP=sg-xxxxxxxxxxxxxxxxx

# IAM role ARNs (from Terraform outputs: terraform output ecs_execution_role_arn)
ECS_EXECUTION_ROLE_ARN=arn:aws:iam::<ACCOUNT_ID>:role/CiviformSandboxEcsExecutionRole
ECS_TASK_ROLE_ARN=arn:aws:iam::<ACCOUNT_ID>:role/CiviformSandboxTaskRole

# CloudWatch log group (matches terraform/ecs.tf)
ECS_LOG_GROUP=/ecs/civiform-sandbox

# ALB HTTPS listener ARN (from Terraform output: terraform output alb_https_listener_arn)
# EcsFargateSandboxService creates per-sandbox listener rules on this listener.
ALB_LISTENER_ARN=arn:aws:elasticloadbalancing:us-east-1:<ACCOUNT_ID>:listener/app/civiform-sandbox-alb/<hash>/<hash>

# CiviForm image to run in each sandbox
CIVIFORM_IMAGE=civiform/civiform:latest

# ── Sprint 2: RDS (shared sandbox Postgres) ────────────────────────────────────
# One RDS instance, per-sandbox Postgres schemas (CREATE SCHEMA per sandbox).

# RDS endpoint (from Terraform output: terraform output rds_endpoint)
RDS_HOST=civiform-sandbox.xxxxxxxxxx.<REGION>.rds.amazonaws.com
RDS_DBNAME=civiform_sandbox

# ARN of the Secrets Manager secret holding the RDS master credentials
# Secret JSON format: {"host":"...", "port":"5432", "username":"...", "password":"...", "dbname":"..."}
RDS_MASTER_SECRET_ARN=arn:aws:secretsmanager:us-east-1:<ACCOUNT_ID>:secret:civiform-sandbox-rds-master-<suffix>
