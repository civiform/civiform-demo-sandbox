    "sass": "^1.81.0",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.1",
    "vite-plugin-static-copy": "^2.2.0"
  },
  "dependencies": {
    "@uswds/uswds": "^3.11.0"
  }
}
