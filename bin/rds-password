#! /usr/bin/env bash
#
# Prints the shared RDS master password from Secrets Manager.
#
#   export RDS_ADMIN_PASSWORD=$(bin/rds-password)
#
# A script rather than a documented one-liner because the secret is JSON, and
# forgetting the `jq -r .password` step yields a password that looks plausible
# in `echo` output but fails authentication.

source bin/lib.sh

REGION="${AWS_REGION:-us-east-1}"
SECRET_ID="${RDS_MASTER_SECRET_ID:-civiform-sandbox/rds-master-password}"

aws secretsmanager get-secret-value \
  --region "$REGION" \
  --secret-id "$SECRET_ID" \
  --query SecretString --output text | jq -r .password
